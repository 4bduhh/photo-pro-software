@echo off
setlocal
title PhotoPrint Pro - Install

set "APP_URL=https://pro-software-ecru.vercel.app/"
set "SELF=%~f0"

set "BROWSER="
for %%P in (
  "%ProgramFiles%\Google\Chrome\Application\chrome.exe"
  "%ProgramFiles(x86)%\Google\Chrome\Application\chrome.exe"
  "%LocalAppData%\Google\Chrome\Application\chrome.exe"
  "%ProgramFiles(x86)%\Microsoft\Edge\Application\msedge.exe"
  "%ProgramFiles%\Microsoft\Edge\Application\msedge.exe"
) do (
  if not defined BROWSER if exist %%P set "BROWSER=%%~P"
)

if not defined BROWSER (
  echo Chrome or Edge was not found on this PC. Please install Google Chrome and run this again.
  pause
  exit /b 1
)

for /f "usebackq delims=" %%D in (`powershell -NoProfile -Command "[Environment]::GetFolderPath('MyDocuments')"`) do set "DOCS=%%D"
if not defined DOCS set "DOCS=%USERPROFILE%\Documents"
set "DATADIR=%DOCS%\PhotoPrint-Data"
if not exist "%DATADIR%" mkdir "%DATADIR%"

set "PROFILE=C:\PhotoPrintPro"
if not exist "%PROFILE%" mkdir "%PROFILE%"

rem ---- 1) take the MURZ icon that is stored inside this file and save it as an .ico ----
set "ICONFILE=%PROFILE%\murz-icon.ico"
if exist "%ICONFILE%" del /f /q "%ICONFILE%" >nul 2>&1
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "try{ $on=$false; $s=New-Object System.Text.StringBuilder; foreach($x in [IO.File]::ReadAllLines($env:SELF)){ if($x -eq '::ICON_END'){break}; if($on){[void]$s.Append($x.Substring(2))}; if($x -eq '::ICON_BEGIN'){$on=$true} }; [IO.File]::WriteAllBytes($env:ICONFILE,[Convert]::FromBase64String($s.ToString())) }catch{}"

rem ---- 2) desktop shortcut (uses the MURZ icon, falls back to browser icon only if it failed) ----
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$icon=$env:BROWSER+',0'; if(Test-Path $env:ICONFILE){ $icon=$env:ICONFILE+',0' };" ^
  "$d=[Environment]::GetFolderPath('Desktop');" ^
  "$s=(New-Object -ComObject WScript.Shell).CreateShortcut((Join-Path $d 'PhotoPrint Pro.lnk'));" ^
  "$s.TargetPath=$env:BROWSER;" ^
  "$s.Arguments='--kiosk-printing --app=' + $env:APP_URL + ' --user-data-dir=' + $env:PROFILE;" ^
  "$s.IconLocation=$icon;" ^
  "$s.Description='PhotoPrint Pro';" ^
  "$s.Save()"

if errorlevel 1 (
  echo Could not create the desktop icon.
  pause
  exit /b 1
)

rem ---- 3) refresh Windows icon cache so the new icon shows right away ----
ie4uinit.exe -show >nul 2>&1

echo.
echo  Done! "PhotoPrint Pro" icon is now on your Desktop.
echo.
echo  Data folder created: %DATADIR%
echo.
echo  IMPORTANT (one time):
echo   Windows Settings ^> Printers ^& scanners ^> choose your photo printer
echo   ^> "Set as default". Print now sends to the default printer.
echo.
pause
exit /b 0
